from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from webdriver_manager.chrome import ChromeDriverManager
from selenium.webdriver.common.by import By
import time
import csv

driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()))
driver.get("https://www.nike.in/catalogsearch/result/?q=shoes&searchType=SearchedFromHistory&internalSearchTerm=shoes")
driver.maximize_window()
time.sleep(3)

last_hieght = driver.execute_script("return document.body.scrollHeight")

while True:
    driver.execute_script("window.scrollTo(0,document.body.scrollHeight)")
    time.sleep(3)

    new_hieght = driver.execute_script("return document.body.scrollHeight")
    if last_hieght == new_hieght:
        print("reached end of page")
        break

    last_hieght = new_hieght
    time.sleep(3)

products = driver.find_elements(By.CSS_SELECTOR,"div.css-1mbp38s")
print("total products:", len(products))

# Open CSV file
with open("nike_shoes.csv","w",newline="",encoding="utf-8") as file:
    writer = csv.writer(file)

    # Header row
    writer.writerow(["Brand","Details","Price","LINK"])

    for p in products:
        try:
            brand = p.find_element(By.CSS_SELECTOR,"div.css-12xgt1").text
        except:
            brand = "brand not found"

        try:
            details = p.find_element(By.CSS_SELECTOR,"div.css-k5ealy").text
        except:
            details = "details not found"

        try:
            price = p.find_element(By.CSS_SELECTOR, "h3.css-v7z842").text
            price = price.replace("₹", "").strip()
        except:
            price = "price not available"

        try:
            link=p.find_element(By.TAG_NAME,"a").get_attribute("href")
        except:
            link = "no link"




        print(brand, details, price,link)

        # Write row in CSV
        writer.writerow([brand, details, price,link])

driver.quit()

