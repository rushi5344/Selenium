from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.common.by import By
from webdriver_manager.chrome import ChromeDriverManager
import time
import csv

# Set up Driver

driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()))
driver.maximize_window()

URL = "https://www.ajio.com/mens-tshirts/c/830216"

query = "relevance"
driver.get(URL)
time.sleep(3)

# 2 Infinite Scroll Function

last_height = driver.execute_script("return document.body.scrollHeight")

while True:
    driver.execute_script("return document.body.scrollHeight")
    time.sleep(2)

    new_height = driver.execute_script("return document.body.scrollHeight")
    print("Scrolling")

    if new_height == last_height:
        print("Reached end of page")
        break

    last_height = new_height
    time.sleep(3)

products = driver.find_elements(
    By.CSS_SELECTOR,
    "div.item.ril.list-item"
)

print("Total Products found", len(products))

# Save to CSV

csv_file = open("ajio-products.csv", "w", newline="", encoding="utf-8")
writer = csv.writer(csv_file)

writer.writerow([
    "Brand",
    "Name",
    "Price",
    "Original Price",
    "Discount",
    "Image URL",
    "Product Link"
])

# Scrape data from each product

for p in products:
    try:
        brand = p.find_element(
            By.CSS_SELECTOR,
            "div.brand"
        ).text
    except:
        brand = ""

    try:
        name = p.find_element(
            By.CSS_SELECTOR,
            "div.nameCls"
        ).text
    except:
        name = ""

    try:
        price = p.find_element(
            By.CSS_SELECTOR,
            "span.price"
        ).text
    except:
        price = ""

    try:
        discount = p.find_element(
            By.CSS_SELECTOR,
            "img"
        ).get_attribute("src")
    except:
        img = ""

    try:
        link = p.find_element(
            By.TAG_NAME,
            "a"
        ).get_attribute("href")
    except:
        link = ""

    writer.writerow([
        brand,
        name,
        price,
        discount,
        link
    ])

csv_file.close()
driver.quit()

print("Scrapping complete. File Saved as ajio-products.csv")
