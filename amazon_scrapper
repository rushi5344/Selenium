from selenium import webdriver
from selenium.common import NoSuchElementException
from webdriver_manager.chrome import ChromeDriverManager
from selenium.webdriver.chrome.service import Service as ChromeService
from selenium.webdriver.common.by import By
import time
import csv


driver=webdriver.Chrome(service=ChromeService(ChromeDriverManager().install()))
driver.get("https://www.amazon.in/")
time.sleep(5)

desi=driver.find_element(By.XPATH,"//input[@placeholder='Search Amazon.in']")
desi.send_keys("watch")
time.sleep(5)

driver.find_element(By.ID, "nav-search-submit-button").click()
time.sleep(5)

watch_name=[]
watch_price=[]
watch_delivery=[]
watch_desc=[]
product_url=[]
brand_name=[]



for page in range(0,2):
    titles=driver.find_elements(By.XPATH,"//a[@class='a-link-normal s-line-clamp-2 puis-line-clamp-3-for-col-4-and-8 s-link-style a-text-normal']")
    for t in titles:
        product_url.append(t.get_attribute('href'))

    next_button=driver.find_element(By.XPATH,"//a[@class='s-pagination-item s-pagination-next s-pagination-button s-pagination-button-accessibility s-pagination-separator']")
    next_button.click()
    time.sleep(5)
print(product_url)
print("total url:",len(product_url))




for i in product_url:
    driver.get(i)
    time.sleep(5)

    # Brand name (try multiple locators)
    try:
        bd = driver.find_element(By.XPATH, "//a[@id='bylineInfo']")
        brand_name.append(bd.text.strip())
    except NoSuchElementException:
        try:
            bd = driver.find_element(By.XPATH, "//tr[th[contains(text(),'Brand')]]/td")
            brand_name.append(bd.text.strip())
        except NoSuchElementException:
            brand_name.append("-")

    try:
        ad = driver.find_element(By.XPATH, "//span[@class='a-price-whole']")
        watch_price.append(ad.text.strip())
    except NoSuchElementException:
        watch_price.append("-")

    # Product name
    try:
        fg = driver.find_element(By.XPATH, "//span[@id='productTitle']")
        watch_name.append(fg.text.strip())
    except NoSuchElementException:
        watch_name.append("-")

    # Delivery info
    try:
        dg = driver.find_element(By.XPATH, "//span[contains(@class,'delivery-message')]")
        watch_delivery.append(dg.text.strip())
    except NoSuchElementException:
        watch_delivery.append("-")

print("Brand names:", brand_name)
print("Watch names:", watch_name)
print("Prices:", watch_price)
print("Delivery:", watch_delivery)


driver.quit()
import csv

# After scraping, you already have these lists:
# brand_name, watch_name, watch_price, watch_delivery, product_url

# Open a CSV file in write mode
with open("watches.csv", "w", newline="", encoding="utf-8") as file:
    writer = csv.writer(file)

    # Write header row
    writer.writerow(["Brand", "Name", "Price", "Delivery", "URL"])

    # Write data rows
    for i in range(len(product_url)):
        writer.writerow([
            brand_name[i] if i < len(brand_name) else "-",
            watch_name[i] if i < len(watch_name) else "-",
            watch_price[i] if i < len(watch_price) else "-",
            watch_delivery[i] if i < len(watch_delivery) else "-",
            product_url[i]
        ])

print("Data saved to watches.csv")

